<Window x:Class="FileBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FileBrowser"
        Title="File Browser" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button" x:Key="HeaderButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="Button" x:Key="TabCloseButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="Button" x:Key="ToolbarButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#555" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TbBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TbBorder" Property="Background" Value="#E8E8E8" />
                                <Setter Property="Foreground" Value="#222" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TbBorder" Property="Background" Value="#D8D8D8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#AAA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Content template used by every tab: column header + tree -->
        <DataTemplate x:Key="TabContentTemplate" DataType="{x:Type local:BrowserTab}">
            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Margin="0,0,0,0">
                <DockPanel>
                    <!-- Column headers -->
                    <Grid DockPanel.Dock="Top" Background="#F5F5F5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding NameWidth, Source={StaticResource Columns}}" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="{Binding ModifiedWidth, Source={StaticResource Columns}}" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="{Binding TypeWidth, Source={StaticResource Columns}}" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="{Binding SizeWidth, Source={StaticResource Columns}}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource HeaderButton}"
                                Content="{Binding NameLabel, Source={StaticResource Sort}}"
                                Click="HeaderName_Click" />
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch" Background="Transparent"
                                      ShowsPreview="False" ResizeBehavior="PreviousAndNext"
                                      Tag="Name" DragDelta="Splitter_DragDelta" />
                        <Button Grid.Column="2" Style="{StaticResource HeaderButton}"
                                Content="{Binding ModifiedLabel, Source={StaticResource Sort}}"
                                Click="HeaderModified_Click" />
                        <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch" Background="Transparent"
                                      ShowsPreview="False" ResizeBehavior="PreviousAndNext"
                                      Tag="Modified" DragDelta="Splitter_DragDelta" />
                        <Button Grid.Column="4" Style="{StaticResource HeaderButton}"
                                Content="{Binding TypeLabel, Source={StaticResource Sort}}"
                                Click="HeaderType_Click" />
                        <GridSplitter Grid.Column="5" Width="6" HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch" Background="Transparent"
                                      ShowsPreview="False" ResizeBehavior="PreviousAndNext"
                                      Tag="Type" DragDelta="Splitter_DragDelta" />
                        <Button Grid.Column="6" Style="{StaticResource HeaderButton}"
                                Content="{Binding SizeLabel, Source={StaticResource Sort}}"
                                Click="HeaderSize_Click"
                                HorizontalContentAlignment="Right" />
                    </Grid>

                    <!-- Tree -->
                    <TreeView ItemsSource="{Binding Roots}" BorderThickness="0"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectedItemChanged="Tree_SelectedItemChanged"
                              PreviewMouseRightButtonUp="Tree_PreviewMouseRightButtonUp"
                              PreviewKeyDown="Tree_PreviewKeyDown"
                              AllowDrop="True"
                              PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="Tree_PreviewMouseLeftButtonUp"
                              PreviewMouseMove="Tree_PreviewMouseMove"
                              MouseDoubleClick="Tree_MouseDoubleClick"
                              PreviewTextInput="Tree_PreviewTextInput"
                              PreviewDragEnter="Tree_DragOver"
                              PreviewDragOver="Tree_DragOver"
                              PreviewDragLeave="Tree_DragLeave"
                              PreviewDrop="Tree_Drop">
                        <TreeView.Resources>
                            <Style TargetType="ToggleButton" x:Key="TreeExpanderStyle">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Width" Value="16" />
                                <Setter Property="Height" Value="16" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Width="16" Height="16">
                                                <Path x:Name="Arrow" HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 0 8 Z"
                                                      Fill="#666" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="Data"
                                                            Value="M 0 0 L 8 0 L 4 4 Z" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <EventSetter Event="Expanded" Handler="TreeViewItem_Expanded" />
                                <EventSetter Event="RequestBringIntoView" Handler="TreeViewItem_RequestBringIntoView" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <StackPanel>
                                                <Border x:Name="Row" Background="Transparent"
                                                        SnapsToDevicePixels="True">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{Binding NameWidth, Source={StaticResource Columns}}" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="{Binding ModifiedWidth, Source={StaticResource Columns}}" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="{Binding TypeWidth, Source={StaticResource Columns}}" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="{Binding SizeWidth, Source={StaticResource Columns}}" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                    Margin="{Binding RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DepthToMargin}}">
                                                            <Border Width="16" Height="16" Background="Transparent">
                                                                <ToggleButton Style="{StaticResource TreeExpanderStyle}"
                                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                                              Visibility="{Binding IsExpandable, Converter={StaticResource BoolToVis}}"
                                                                              ClickMode="Press" />
                                                            </Border>
                                                            <Image Source="{Binding Icon}" Width="16" Height="16"
                                                                   VerticalAlignment="Center" Margin="2,0,6,0"
                                                                   SnapsToDevicePixels="True" />
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding ModifiedText}"
                                                                   VerticalAlignment="Center" Foreground="#666" />
                                                        <TextBlock Grid.Column="4" Text="{Binding TypeDescription}"
                                                                   VerticalAlignment="Center" Foreground="#666" />
                                                        <TextBlock Grid.Column="6" Text="{Binding SizeText}"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                                                   Foreground="#666" Margin="0,0,6,0" />
                                                    </Grid>
                                                </Border>
                                                <ItemsPresenter x:Name="ItemsHost"
                                                                Visibility="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#CCE8FF" />
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsSelected" Value="True" />
                                                        <Condition Property="IsSelectionActive" Value="False" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Row" Property="Background" Value="#E5E5E5" />
                                                </MultiTrigger>
                                                <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#CCE8FF" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#FFE6C200" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}" />
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- Toolbar -->
        <Grid DockPanel.Dock="Top" Margin="8,8,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource ToolbarButton}" Click="Refresh_Click" ToolTip="Refresh" Content="&#x21BB;" FontSize="14" />
            <Button x:Name="FavoritesToggle" Grid.Column="1" Margin="4,0,0,0" Style="{StaticResource ToolbarButton}"
                    Click="FavoritesToggle_Click" ToolTip="Favorites" Content="&#x2605;" FontSize="14" />
            <TextBox x:Name="PathBox" Grid.Column="2" Margin="6,0,0,0" Padding="6,4"
                     VerticalContentAlignment="Center" KeyDown="PathBox_KeyDown" />
            <Button Grid.Column="3" Margin="4,0,0,0" Style="{StaticResource ToolbarButton}" Click="Browse_Click" Content="Browse..." />
        </Grid>

        <!-- Favorites popup -->
        <Popup x:Name="FavoritesPopup" PlacementTarget="{Binding ElementName=FavoritesToggle}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" HorizontalOffset="0" VerticalOffset="2">
            <Border Background="White" BorderBrush="#AAA" BorderThickness="1" CornerRadius="3"
                    Padding="0" SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.35" Color="Black" />
                </Border.Effect>
                <DockPanel MinWidth="260" MaxHeight="480">
                    <Grid DockPanel.Dock="Top" Background="#F5F5F5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Favorites" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="8,4" />
                        <Button Grid.Column="1" Content="＋" Padding="6,0" Margin="0,2"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Click="AddFavorite_Click" ToolTip="Add active tab's folder" />
                        <Button Grid.Column="2" Content="－" Padding="6,0" Margin="0,2,4,2"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Click="RemoveFavorite_Click" ToolTip="Remove selected favorite" />
                    </Grid>
                    <ListBox x:Name="FavoritesList"
                             ItemsSource="{Binding Favorites, RelativeSource={RelativeSource AncestorType=Window}}"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             MouseDoubleClick="FavoritesList_MouseDoubleClick"
                             KeyDown="FavoritesList_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:Favorite}">
                                <StackPanel Orientation="Horizontal" Margin="2" ToolTip="{Binding Path}">
                                    <Image Source="{Binding Icon}" Width="16" Height="16"
                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                           SnapsToDevicePixels="True" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open in active tab" Click="FavoriteOpen_Click" />
                                <MenuItem Header="Open in new tab" Click="FavoriteOpenNewTab_Click" />
                                <Separator />
                                <MenuItem Header="Remove" Click="RemoveFavorite_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Border>
        </Popup>

        <!-- Status bar -->
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="10,2,10,6"
                   Foreground="Gray" FontSize="11" />

        <!-- Main area: pane tree only; favorites are a popup off the toolbar -->
        <DockPanel Margin="8,0,8,4">
                <DockPanel.Resources>
                    <DataTemplate DataType="{x:Type local:LeafPane}">
                        <Border BorderThickness="0" Padding="0"
                                PreviewMouseDown="LeafPaneHost_PreviewMouseDown">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                </Style>
                            </Border.Style>
                            <TabControl ItemsSource="{Binding Tabs}"
                                    SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                                    ContentTemplate="{StaticResource TabContentTemplate}"
                                    SelectionChanged="LeafTabControl_SelectionChanged"
                                    GotFocus="LeafTabControl_GotFocus"
                                    AllowDrop="True"
                                    PreviewDragEnter="LeafPane_DragOver"
                                    PreviewDragOver="LeafPane_DragOver"
                                    PreviewDragLeave="LeafPane_DragLeave"
                                    PreviewDrop="LeafPane_Drop">
                            <TabControl.Template>
                                <ControlTemplate TargetType="TabControl">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <TabPanel IsItemsHost="True" Background="Transparent" />
                                            <Button Width="24" Height="22"
                                                    VerticalAlignment="Bottom" Margin="4,0,0,1"
                                                    Click="NewTab_Click" ToolTip="New tab"
                                                    Focusable="False"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="#888"
                                                    Padding="0"
                                                    FontSize="14">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="NewTabBorder"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="3"
                                                                Padding="0">
                                                            <TextBlock Text="+" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{TemplateBinding Foreground}"
                                                                       FontSize="{TemplateBinding FontSize}" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="NewTabBorder" Property="Background" Value="#E8E8E8" />
                                                                <Setter Property="Foreground" Value="#333" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="NewTabBorder" Property="Background" Value="#D8D8D8" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                        <Grid Grid.Row="1">
                                            <Border BorderBrush="#DDD" BorderThickness="1"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter ContentSource="SelectedContent"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                                            </Border>
                                            <Border x:Name="DropOverlay" Background="#4000A0FF"
                                                    BorderBrush="#FF00A0FF" BorderThickness="2"
                                                    IsHitTestVisible="False" Visibility="Collapsed" />
                                        </Grid>
                                    </Grid>
                                </ControlTemplate>
                            </TabControl.Template>
                            <TabControl.ItemContainerStyle>
                                <Style TargetType="TabItem">
                                    <Setter Property="AllowDrop" Value="True" />
                                    <Setter Property="MinWidth" Value="120" />
                                    <Setter Property="Padding" Value="8,3" />
                                    <Setter Property="Background" Value="#F0F0F0" />
                                    <Setter Property="BorderBrush" Value="#CCCCCC" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TabItem">
                                                <Border x:Name="TabBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Margin="0,0,1,0" CornerRadius="3,3,0,0">
                                                    <ContentPresenter ContentSource="Header"
                                                                      Margin="{TemplateBinding Padding}"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="TabBorder" Property="Background" Value="White" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TabItem_PreviewMouseLeftButtonDown" />
                                    <EventSetter Event="MouseDoubleClick" Handler="TabItem_MouseDoubleClick" />
                                    <EventSetter Event="PreviewMouseMove" Handler="TabItem_PreviewMouseMove" />
                                    <EventSetter Event="DragEnter" Handler="TabItem_DragEnter" />
                                    <EventSetter Event="DragOver" Handler="TabItem_DragEnter" />
                                    <EventSetter Event="DragLeave" Handler="TabItem_DragLeave" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                                <Condition Binding="{Binding DataContext.IsActive, RelativeSource={RelativeSource AncestorType=TabControl}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="BorderBrush" Value="#FF2E7DD1" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TabControl.ItemContainerStyle>
                            <TabControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:BrowserTab}">
                                    <DockPanel MinWidth="110" LastChildFill="True">
                                        <DockPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Close" Click="TabMenuClose_Click" Tag="{Binding}" />
                                                <MenuItem Header="Close all but this" Click="TabMenuCloseOthers_Click" Tag="{Binding}" />
                                                <MenuItem Header="Close all to the left" Click="TabMenuCloseLeft_Click" Tag="{Binding}" />
                                                <MenuItem Header="Close all to the right" Click="TabMenuCloseRight_Click" Tag="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="Split Right" Click="TabMenuSplitRight_Click" Tag="{Binding}" />
                                                <MenuItem Header="Split Down" Click="TabMenuSplitDown_Click" Tag="{Binding}" />
                                            </ContextMenu>
                                        </DockPanel.ContextMenu>
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource TabCloseButton}" Content="✕"
                                                Click="CloseTab_Click"
                                                Tag="{Binding}" ToolTip="Close tab" />
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                    </DockPanel>
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                        </TabControl>
                        </Border>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type local:SplitPane}">
                        <local:SplitPaneView />
                    </DataTemplate>
                </DockPanel.Resources>
                <ContentControl Content="{Binding Root, RelativeSource={RelativeSource AncestorType=Window}}" />
            </DockPanel>
    </DockPanel>
</Window>
